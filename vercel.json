{
  "buildCommand": "pnpm ng build",
  "outputDirectory": "dist/portfolio-angular/browser",
  "rewrites": [
    {
      "source": "/ssr-api/:path*",
      "destination": "${API_URL}/:path*",
      "headers": {
        "X-API-Key": "${API_KEY}"
      }
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
